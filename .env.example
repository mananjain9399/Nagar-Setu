# ==============================================================================
# NAGAR SETU (नगर सेतु) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (Required in Production: Supabase / Neon / PostgreSQL)
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/bhopal_civic_engine?schema=public"

# AI Pipeline Configuration (Optional: defaults to deterministic verified fallback)
AI_PROVIDER="deterministic_fallback"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# CORS Configuration (Optional: comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Node Environment
NODE_ENV="production"
