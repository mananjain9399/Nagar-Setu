# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# You can connect to your local PostgreSQL instance, or use the built-in embedded PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/bhopal_civic_engine?schema=public"

# Dataset Environment
DATASET_ENV="SYNTHETIC_DEVELOPMENT"
EMBEDDED_PG_PORT=5432

# AI Provider Configuration
# Set to "deterministic_fallback" if no external API key is provided
AI_PROVIDER="deterministic_fallback"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
